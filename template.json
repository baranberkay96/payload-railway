{
  "name": "Payload 3 CMS Website (Postgres, S3 Bucket)",
  "description": "Payload 3 + Next.js website: pages, posts, forms, SEO, media in a Bucket.",
  "category": "CMS",
  "tags": [
    "payload",
    "payloadcms",
    "headless-cms",
    "nextjs",
    "website",
    "postgres",
    "s3",
    "typescript"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/payload.png",
  "upstream": {
    "repo": "payloadcms/payload",
    "version": "v3.93.0 packages (templates/with-vercel-website at tag v3.94.0)",
    "images": {
      "node": "node:22.23.5-alpine3.23@sha256:6868d4695b947ee120bffaa463fecd68cde370d7bfec92955e7c8ac576b4f475",
      "postgres": "ghcr.io/railwayapp-templates/postgres-ssl:18.6 (Railway base)"
    },
    "npm": "payload 3.93.0, @payloadcms/* 3.93.0, next 16.4.6, react 19.2.9 (package-lock.json)",
    "checked": "2026-11-20"
  },
  "services": {
    "Payload": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/payload.png",
      "source": {
        "repo": "baranberkay96/payload-railway",
        "rootDirectory": "/services/payload"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/health",
      "healthcheckTimeout": 900,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 3000,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "HTTP port of the website, admin panel and API (domain target and healthcheck).",
          "required": false
        },
        "NEXT_PUBLIC_SERVER_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL, compiled into the site at build time (links, SEO, CORS). After adding a custom domain, change it and redeploy.",
          "required": false
        },
        "PAYLOAD_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs Payload sessions and tokens. Changing it signs everyone out.",
          "required": false
        },
        "PREVIEW_SECRET": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Protects draft preview links.",
          "required": false
        },
        "CRON_SECRET": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Bearer token for running Payload jobs from an external scheduler.",
          "required": false
        },
        "ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "E-mail (login) of the first admin, created on the first start. Change it before deploying or later in the admin panel.",
          "required": false
        },
        "ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password of the first admin (12-128 characters). Generated; read it here to log in.",
          "required": false
        },
        "ADMIN_NAME": {
          "defaultValue": "Admin",
          "description": "Display name of the first admin.",
          "required": false
        },
        "RESET_ADMIN_PASSWORD": {
          "defaultValue": "false",
          "description": "true = on the next start, set the password of ADMIN_EMAIL to ADMIN_PASSWORD. Set back to false afterwards.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Postgres on the private network. The bundled migrations run on start.",
          "required": false
        },
        "S3_ACCESS_KEY_ID": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Railway Bucket access key (media uploads).",
          "required": false
        },
        "S3_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Railway Bucket secret key.",
          "required": false
        },
        "S3_BUCKET": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Railway Bucket name.",
          "required": false
        },
        "S3_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Railway Bucket region.",
          "required": false
        },
        "S3_ENDPOINT": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Railway Bucket S3 endpoint.",
          "required": false
        },
        "NEXT_TELEMETRY_DISABLED": {
          "defaultValue": "1",
          "description": "No Next.js telemetry.",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "Private connection URL used by Payload.",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": false
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": false
        }
      }
    }
  },
  "buckets": [
    "Bucket"
  ]
}